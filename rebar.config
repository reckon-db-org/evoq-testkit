{erl_opts, [debug_info]}.

%% evoq-testkit is a test-support library: its purpose is to test evoq
%% aggregates, so evoq + mem-evoq + reckon_gater are genuine (not
%% test-profile) dependencies. Consumers add evoq_testkit to their OWN
%% test profile.
%%
%% Dependency DAG (no cycle): evoq_testkit -> evoq
%%                            evoq_testkit -> mem_evoq -> evoq
%%                            evoq_testkit -> reckon_gater
{deps, [
    {evoq, "~> 1.19"},
    {mem_evoq, "~> 0.1"},
    {reckon_gater, "~> 3.11"}
]}.

%% Pinned, because a plugin in the release path is part of the release. The
%% pin lives in this file, so it is inside the tag: a plugin that breaks
%% publishing cannot be fixed by re-running the tag's job, only by cutting a
%% new version. rebar3_hex 7.3.0 resolves credentials through hex_core 0.19's
%% hex_cli_auth, which reads a cli_auth_callbacks map that only rebar3 3.27.1
%% and later supply; on the 3.27.0 the workflows pin, that lookup is a bare
%% badmatch and HEX_API_KEY is never read, so publish dies right after the
%% CoC notice. 7.2.0 reads the environment variable. The others are the
%% versions reckon-db and evoq pin. Bump one in its own commit, with the
%% reason.
{project_plugins, [
    {rebar3_ex_doc, "0.3.0"},
    {rebar3_hex, "7.2.0"},
    {rebar3_lint, "6.0.0"}
]}.

%% Elvis style rules — shared macula_min ruleset (mirrors evoq/reckon-db).
%% Targets deep nesting, nested try/catch, if-expressions. Run `rebar3 lint`.
{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["src/**/*.erl"], ruleset => macula_min}
    ]}
]}.

{ex_doc, [
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>},
    {source_url, <<"https://github.com/reckon-db-org/evoq-testkit">>}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
